# MT5 terminal credentials. Leave blank to use the already logged-in terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Trading configuration
SYMBOL=EURUSD
LOT=0.05
MAGIC=26092026
DRY_RUN=true
POLL_SECONDS=5
MAX_SPREAD_POINTS=20
DAILY_LOSS_LIMIT=100

# Optional: a calendar endpoint returning a JSON array of events.
# Events must expose `time` (ISO 8601/Unix timestamp), `currency`, and either
# `impact` (high/medium/low) or `importance` (3 means high).
NEWS_URL=
NEWS_CURRENCIES=USD,EUR
NEWS_BLOCK_BEFORE_MINUTES=30
NEWS_BLOCK_AFTER_MINUTES=15
