# Create an API key at GapGPT and set it here. It is never sent to the browser.
GAPGPT_API_KEY=your_gapgpt_api_key
# Verify this base URL against your GapGPT dashboard/documentation if it changes.
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-5.6
# Optional: a Tavily key gives the assistant fresh web research snippets.
TAVILY_API_KEY=
